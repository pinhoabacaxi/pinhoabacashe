<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/btnPlayNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:text="Tocar a seguir"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:drawableStartCompat="@android:drawable/ic_media_play"
        app:drawableTint="#FFFFFF" />

    <TextView
        android:id="@+id/btnAddToQueue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:text="Adicionar ao final da fila"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:drawableStartCompat="@android:drawable/ic_input_add"
        app:drawableTint="#FFFFFF" />

    <TextView
        android:id="@+id/btnDownloadMp3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:text="Baixar música (MP3)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:drawableStartCompat="@android:drawable/stat_sys_download"
        app:drawableTint="#FFFFFF" />

    <TextView
        android:id="@+id/btnAddToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:text="Adicionar à Playlist..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:drawableStartCompat="@android:drawable/ic_menu_add"
        app:drawableTint="#FFFFFF" />

</LinearLayout>
